# WealthWise AI AI - Environment Variables
# Copy this file to .env and fill in your values

# OpenAI API Key (required)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional model overrides (defaults shown)
# WEALTHWISE_CHAT_MODEL=gpt-4o-mini
# WEALTHWISE_EMBEDDING_MODEL=text-embedding-3-small
# WEALTHWISE_TEMPERATURE=0.2

# Where the local Chroma vector store is persisted
# WEALTHWISE_CHROMA_DIR=.wealthwise_chroma
